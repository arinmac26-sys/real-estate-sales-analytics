      <column caption='Sales Ratio Category' datatype='string' name='[Calculation_0372011128487941]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sales Ratio] &lt; 0.75 THEN&#10;    &quot;Low Ratio&quot;&#10;ELSEIF [Sales Ratio] &lt; 1 THEN&#10;    &quot;Near 1&quot;&#10;ELSE&#10;    &quot;Above 1&quot;&#10;END' />
