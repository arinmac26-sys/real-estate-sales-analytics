      </column>
      <column caption='Sale Category' datatype='string' name='[Calculation_0372011128164354]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sale Amount] &lt; 250000 THEN&#10;    &quot;Low&quot;&#10;ELSEIF [Sale Amount] &lt; 500000 THEN&#10;    &quot;Medium&quot;&#10;ELSE&#10;    &quot;High&quot;&#10;END' />
